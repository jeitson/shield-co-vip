# ─────────────────────────────────────────────────────────────────────────────
# Cifrado Cero — Variables de entorno del backend (Supabase)
# Copia este archivo a `.env` y rellena los valores reales. NUNCA subas `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Referencia del proyecto Supabase (parte del subdominio del proyecto).
# Ej.: si tu URL es https://abcdefgh.supabase.co → el ref es "abcdefgh".
SUPABASE_PROJECT_REF=

# URL base del proyecto Supabase.
# Ej.: https://abcdefgh.supabase.co
SUPABASE_URL=

# Clave anónima (pública). Segura para incrustar en el cliente: el acceso a
# datos lo protege RLS. La usa la app Flutter.
SUPABASE_ANON_KEY=

# ── SECRETOS (solo backend / CI, NUNCA en la app ni en el repo) ──────────────

# Clave service_role. Omnipotente (ignora RLS). Solo para administración/CI.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña de la base de datos (para `supabase db push`).
SUPABASE_DB_PASSWORD=
